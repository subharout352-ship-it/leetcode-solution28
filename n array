"""
# Definition for a Node.
class Node(object):
    def __init__(self, val=None, children=None):
        self.val = val
        self.children = children
"""

class Solution(object):
    def levelOrder(self, root):
        """
        :type root: Node
        :rtype: List[List[int]]
        """
        if not root:
            return []

        result = []
        queue = [root]

        while queue:
            level = []
            size = len(queue)

            for _ in range(size):
                node = queue.pop(0)
                level.append(node.val)

                for child in node.children:
                    if child:
                        queue.append(child)

            result.append(level)

        return result
